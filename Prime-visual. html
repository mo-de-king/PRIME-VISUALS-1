<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prime Visuals — Learn Today. Build Tomorrow. Live Your Prime.</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700;800&family=Caveat:wght@600&display=swap');

  :root{
    --bg:#0B0614;
    --bg-2:#170A2B;
    --panel:#150C26;
    --line:#3A2A5C;
    --gold:#D9B24C;
    --gold-soft:#F1D98A;
    --purple:#9B4FE0;
    --purple-deep:#5C1E9C;
    --ink:#F4F0FA;
    --ink-dim:#B9AECF;
    --display:'Archivo Black', Impact, sans-serif;
    --body:'Inter', sans-serif;
    --script:'Caveat', cursive;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:var(--body);
    background:var(--bg);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }

  .wrap{max-width:1140px;margin:0 auto;padding:0 28px;}
  a{color:inherit;text-decoration:none;}
  ul{margin:0;padding:0;list-style:none;}

  .texture{
    position:fixed; inset:0; pointer-events:none; z-index:0;
    background-image:
      radial-gradient(circle at 8% 10%, rgba(217,178,76,0.13) 0, transparent 38%),
      radial-gradient(circle at 95% 4%, rgba(155,79,224,0.22) 0, transparent 42%),
      radial-gradient(circle at 50% 70%, rgba(92,30,156,0.16) 0, transparent 50%),
      radial-gradient(circle at 4% 85%, rgba(217,178,76,0.08) 0, transparent 40%);
  }

  /* ============ NAV ============ */
  nav{
    position:sticky; top:0; z-index:50;
    background:rgba(11,6,20,0.85);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 0;
    border-bottom:1px solid var(--line);
  }
  .logo{display:flex; align-items:center; gap:12px;}
  .logo-mark{
    width:46px; height:46px;
    border:2px solid var(--gold);
    background:linear-gradient(135deg, rgba(217,178,76,0.16), rgba(155,79,224,0.16));
    border-radius:10px;
    display:flex; align-items:center; justify-content:center;
    font-family:var(--display);
    font-size:1rem;
    color:var(--gold);
    transform:rotate(-4deg);
    box-shadow:0 6px 16px rgba(217,178,76,0.25);
  }
  .logo-text{
    font-family:var(--display);
    font-size:1.05rem;
    letter-spacing:0.02em;
    line-height:1;
  }
  .logo-text span{
    display:block;
    font-size:0.52rem;
    font-family:var(--body);
    font-weight:600;
    letter-spacing:0.24em;
    color:var(--gold-soft);
    margin-top:4px;
  }
  .nav-links{display:flex; gap:26px; font-size:0.85rem; font-weight:600; color:var(--ink-dim);}
  .nav-links a{transition:color .18s ease;}
  .nav-links a:hover{color:var(--gold-soft);}
  nav .cta{
    font-weight:700; font-size:0.82rem;
    padding:11px 24px;
    background:linear-gradient(120deg, var(--gold), var(--gold-soft));
    color:#241206;
    border-radius:999px;
    box-shadow:0 6px 22px rgba(217,178,76,0.35);
    transition:transform .18s ease, box-shadow .18s ease;
  }
  nav .cta:hover{transform:translateY(-2px); box-shadow:0 10px 28px rgba(217,178,76,0.5);}

  /* ============ HERO ============ */
  header.hero{position:relative; z-index:1; padding:80px 0 70px; overflow:hidden;}
  header.hero::before{
    content:""; position:absolute; top:-160px; right:-120px;
    width:540px; height:540px;
    background:radial-gradient(circle, rgba(155,79,224,0.35) 0%, transparent 70%);
    filter:blur(10px); pointer-events:none; z-index:-1;
  }
  header.hero::after{
    content:""; position:absolute; bottom:-180px; left:-140px;
    width:440px; height:440px;
    background:radial-gradient(circle, rgba(217,178,76,0.22) 0%, transparent 70%);
    filter:blur(10px); pointer-events:none; z-index:-1;
  }
  .hero-grid{display:grid; grid-template-columns:1.1fr 0.9fr; gap:44px; align-items:center;}
  .eyebrow{
    font-weight:800; font-size:0.75rem;
    letter-spacing:0.18em; color:var(--purple);
    margin-bottom:16px;
  }
  h1.headline{
    font-family:var(--display);
    font-size:clamp(2rem, 5vw, 3.3rem);
    line-height:1.1;
    margin:0 0 24px;
    text-transform:uppercase;
  }
  .hl-gold{
    background:linear-gradient(100deg, var(--gold), var(--gold-soft));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hl-purple{
    background:linear-gradient(100deg, #7C3ED0, var(--purple));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero-copy{
    color:var(--ink-dim);
    font-size:1.02rem;
    max-width:48ch;
    margin:0 0 30px;
    line-height:1.65;
  }
  .hero-copy strong{color:var(--gold-soft);}
  .hero-ctas{display:flex; gap:14px; flex-wrap:wrap;}
  .btn-primary{
    background:linear-gradient(120deg, var(--purple-deep), var(--purple));
    color:var(--ink);
    padding:15px 30px;
    font-weight:700; font-size:0.92rem;
    border-radius:999px;
    border:1px solid var(--purple);
    box-shadow:0 10px 26px rgba(155,79,224,0.35);
    transition:transform .18s ease, box-shadow .18s ease;
    display:inline-block; cursor:pointer;
  }
  .btn-primary:hover{transform:translateY(-2px); box-shadow:0 14px 32px rgba(155,79,224,0.5);}
  .btn-ghost{
    padding:15px 30px;
    font-weight:700; font-size:0.92rem;
    border:1px solid var(--line);
    color:var(--ink-dim);
    border-radius:999px;
    transition:border-color .18s ease, color .18s ease;
    display:inline-block;
  }
  .btn-ghost:hover{border-color:var(--gold); color:var(--gold-soft);}

  .hero-visual{
    position:relative; height:380px;
    border:1px solid var(--line);
    border-radius:22px;
    background:linear-gradient(160deg, rgba(155,79,224,0.14), rgba(23,10,43,0.6));
    box-shadow:0 24px 50px rgba(0,0,0,0.45);
    overflow:hidden;
  }
  .hero-visual::before{
    content:"PV";
    position:absolute; inset:0;
    display:flex; align-items:center; justify-content:center;
    font-family:var(--display);
    font-size:9rem;
    background:linear-gradient(135deg, rgba(217,178,76,0.18), rgba(155,79,224,0.18));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .float-chip{
    position:absolute;
    font-family:var(--display);
    font-size:0.62rem;
    letter-spacing:0.06em;
    padding:10px 14px;
    border-radius:10px;
    color:var(--ink);
    box-shadow:0 12px 28px rgba(0,0,0,0.45);
    border:1px solid rgba(255,255,255,0.12);
    background:var(--panel);
    animation:drift 6s ease-in-out infinite;
  }
  .float-chip b{color:var(--gold);}
  .float-chip:nth-child(1){top:9%; left:7%; animation-delay:0s;}
  .float-chip:nth-child(2){top:20%; right:9%; animation-delay:.7s;}
  .float-chip:nth-child(3){top:44%; left:14%; animation-delay:1.4s;}
  .float-chip:nth-child(4){top:60%; right:15%; animation-delay:2.1s;}
  .float-chip:nth-child(5){bottom:10%; left:32%; animation-delay:2.8s;}
  @keyframes drift{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
  @media (prefers-reduced-motion:reduce){.float-chip{animation:none;}}

  .ticker{
    margin-top:56px;
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    overflow:hidden;
    padding:13px 0;
    white-space:nowrap;
  }
  .ticker-track{display:inline-block; animation:scrollTicker 26s linear infinite;}
  .ticker span{
    font-family:var(--display);
    font-size:0.78rem;
    letter-spacing:0.14em;
    color:var(--gold-soft);
    margin-right:48px;
  }
  .ticker span i{font-style:normal; color:var(--purple); margin-right:48px;}
  @keyframes scrollTicker{from{transform:translateX(0);}to{transform:translateX(-50%);}}

  /* ============ SECTIONS ============ */
  .section{position:relative; z-index:1; padding:64px 0;}
  .pill-heading{
    display:inline-flex; align-items:center;
    background:linear-gradient(120deg, rgba(217,178,76,0.14), rgba(155,79,224,0.14));
    border:1px solid var(--gold);
    border-radius:999px;
    padding:11px 30px;
    font-family:var(--display);
    font-size:0.92rem;
    letter-spacing:0.04em;
    color:var(--ink);
    margin-bottom:38px;
    box-shadow:0 8px 24px rgba(217,178,76,0.14);
  }
  .section-center{text-align:center;}

  /* ============ LEARN GRID ============ */
  .learn-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:18px;}
  .learn-col{
    background:linear-gradient(165deg, var(--panel), #110A1F);
    border:1px solid var(--line);
    border-radius:16px;
    padding:26px 20px;
    position:relative;
    box-shadow:0 14px 30px rgba(0,0,0,0.35);
    transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .learn-col::before{
    content:""; position:absolute; top:0; left:20px; right:20px; height:3px;
    border-radius:0 0 3px 3px;
  }
  .learn-col:hover{
    transform:translateY(-6px);
    box-shadow:0 20px 42px rgba(0,0,0,0.5);
    border-color:rgba(217,178,76,0.4);
  }
  .learn-col .icon{
    width:48px; height:48px;
    border-radius:14px;
    display:flex; align-items:center; justify-content:center;
    margin-bottom:16px;
    font-size:1.3rem;
    box-shadow:0 10px 22px rgba(0,0,0,0.4);
  }
  .learn-col h3{
    font-weight:800; font-size:0.92rem;
    letter-spacing:0.02em;
    margin:0 0 14px;
  }
  .learn-col ul li{
    font-size:0.8rem;
    color:var(--ink-dim);
    padding:6px 0 6px 14px;
    border-top:1px solid rgba(255,255,255,0.07);
    position:relative;
  }
  .learn-col ul li::before{
    content:"▸"; position:absolute; left:0; color:var(--gold); font-size:0.7rem;
  }
  .learn-col ul li:first-child{border-top:none;}

  .c-creative::before{background:linear-gradient(90deg,#B15CE0,#6B2FA8);}
  .c-tech::before{background:linear-gradient(90deg,#4C8FE0,#2D5FB0);}
  .c-digital::before{background:linear-gradient(90deg,#4FBE7A,#2D8C53);}
  .c-business::before{background:linear-gradient(90deg,#E0A34C,#B8742A);}
  .c-ai::before{background:linear-gradient(90deg,#B9A8E8,#7C5FD1);}
  .c-creative .icon{background:linear-gradient(135deg,#B15CE0,#6B2FA8);}
  .c-tech .icon{background:linear-gradient(135deg,#4C8FE0,#2D5FB0);}
  .c-digital .icon{background:linear-gradient(135deg,#4FBE7A,#2D8C53);}
  .c-business .icon{background:linear-gradient(135deg,#E0A34C,#B8742A);}
  .c-ai .icon{background:linear-gradient(135deg,#B9A8E8,#7C5FD1);}

  /* ============ FEATURES ============ */
  .features{display:grid; grid-template-columns:repeat(6,1fr); gap:16px;}
  .feature{
    background:linear-gradient(165deg, var(--panel), #110A1F);
    border:1px solid var(--line);
    border-radius:16px;
    padding:26px 16px;
    text-align:center;
    box-shadow:0 12px 26px rgba(0,0,0,0.3);
    transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .feature:hover{
    transform:translateY(-5px);
    border-color:rgba(217,178,76,0.4);
    box-shadow:0 18px 34px rgba(0,0,0,0.42);
  }
  .feature .fi{
    width:42px; height:42px;
    margin:0 auto 12px;
    border:1.5px solid var(--gold);
    background:rgba(217,178,76,0.08);
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    color:var(--gold);
    box-shadow:0 8px 18px rgba(217,178,76,0.18);
    font-size:1.1rem;
  }
  .feature h4{font-size:0.82rem; font-weight:700; margin:0 0 6px;}
  .feature p{font-size:0.75rem; color:var(--ink-dim); margin:0; line-height:1.45;}

  /* ============ EDUCATOR + DETAILS ============ */
  .split-two{display:grid; grid-template-columns:1fr 1fr; gap:22px;}
  .educator-card, .details-card{
    border:1px solid var(--gold);
    border-radius:20px;
    padding:34px;
    position:relative;
    overflow:hidden;
    box-shadow:0 18px 40px rgba(0,0,0,0.4);
  }
  .educator-card{background:linear-gradient(160deg, rgba(155,79,224,0.22), rgba(11,6,20,0.25));}
  .educator-card::after{
    content:"👑"; position:absolute; right:-10px; bottom:-30px;
    font-size:7rem; opacity:0.07;
  }
  .details-card{background:linear-gradient(160deg, rgba(217,178,76,0.16), rgba(11,6,20,0.25));}
  .details-card::after{
    content:"★"; position:absolute; right:0; bottom:-40px;
    font-size:8rem; opacity:0.05; color:var(--gold);
  }
  .tag-line{
    font-weight:700; font-size:0.68rem;
    letter-spacing:0.16em; color:var(--purple);
    margin-bottom:16px;
  }
  .details-card .tag-line{color:var(--gold);}
  .educator-name{
    font-family:var(--display);
    font-size:1.7rem;
    margin:0 0 6px;
    color:var(--gold-soft);
  }
  .educator-role{color:var(--ink-dim); font-size:0.9rem; margin:0 0 22px;}
  .join-btn{
    display:inline-block;
    background:linear-gradient(120deg, var(--purple-deep), var(--purple));
    padding:13px 28px;
    font-weight:700; font-size:0.85rem;
    border-radius:999px;
    box-shadow:0 10px 26px rgba(155,79,224,0.4);
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .join-btn:hover{transform:translateY(-2px); box-shadow:0 14px 32px rgba(155,79,224,0.5);}
  .details-card .row{
    display:flex; justify-content:space-between; align-items:baseline;
    padding:15px 0;
    border-top:1px solid rgba(217,178,76,0.25);
  }
  .details-card .row:first-of-type{border-top:none;}
  .details-card .row .k{color:var(--ink-dim); font-size:0.82rem;}
  .details-card .row .v{font-family:var(--display); font-size:1.05rem; color:var(--ink); text-align:right;}
  .price-badge{
    display:inline-flex; align-items:center;
    padding:8px 22px;
    border-radius:999px;
    border:1px solid var(--gold);
    background:linear-gradient(120deg, rgba(217,178,76,0.16), rgba(155,79,224,0.16));
    box-shadow:0 0 26px rgba(217,178,76,0.4), inset 0 0 12px rgba(217,178,76,0.08);
    animation:pulseGlow 2.6s ease-in-out infinite;
  }
  .price-text{
    font-family:var(--display);
    font-size:1.3rem;
    background:linear-gradient(90deg, var(--gold-soft), var(--gold), var(--purple), var(--gold-soft));
    background-size:300% auto;
    -webkit-background-clip:text; background-clip:text; color:transparent;
    animation:shimmer 3.5s linear infinite;
  }
  @keyframes shimmer{0%{background-position:0% 50%;}100%{background-position:300% 50%;}}
  @keyframes pulseGlow{
    0%,100%{box-shadow:0 0 20px rgba(217,178,76,0.32), inset 0 0 10px rgba(217,178,76,0.06);}
    50%{box-shadow:0 0 34px rgba(217,178,76,0.55), inset 0 0 16px rgba(217,178,76,0.14);}
  }
  @media (prefers-reduced-motion:reduce){.price-badge,.price-text{animation:none;}}

  /* ============ WHATSAPP REFERRAL DASHBOARD ============ */
  .dash-panel{
    border:1px solid rgba(37,211,102,0.35);
    border-radius:22px;
    padding:44px;
    background:
      radial-gradient(circle at 90% 0%, rgba(37,211,102,0.10), transparent 45%),
      linear-gradient(180deg, #17102B, #110A20);
    box-shadow:0 24px 52px rgba(0,0,0,0.5);
    position:relative;
    overflow:hidden;
  }
  .dash-panel::before{
    content:"";
    position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg, var(--gold), var(--purple), #25D366);
  }
  .dash-head{display:flex; gap:18px; align-items:flex-start; margin-bottom:30px;}
  .dash-icon{
    width:52px; height:52px; flex:0 0 auto;
    border-radius:14px;
    background:linear-gradient(135deg, #128C4B, #25D366);
    display:flex; align-items:center; justify-content:center;
    font-size:1.5rem;
    box-shadow:0 10px 26px rgba(37,211,102,0.35);
  }
  .dash-head h3{
    font-family:var(--display);
    font-size:1.35rem;
    margin:2px 0 8px;
    font-weight:400;
  }
  .dash-head p{color:var(--ink-dim); font-size:0.92rem; margin:0; max-width:60ch; line-height:1.6;}
  .dash-grid{display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px;}
  .field{display:flex; flex-direction:column; gap:8px;}
  .field.full{grid-column:1 / -1;}
  .field label{font-size:0.82rem; font-weight:600;}
  .field label .req{color:var(--gold);}
  .field input, .field select{
    font-family:var(--body);
    font-size:0.94rem;
    padding:14px 16px;
    background:#0D0818;
    border:1px solid var(--line);
    border-radius:10px;
    color:var(--ink);
    transition:border-color .18s ease, box-shadow .18s ease;
    width:100%;
  }
  .field input::placeholder{color:#6E6284;}
  .field input:focus, .field select:focus{
    border-color:#25D366;
    box-shadow:0 0 0 3px rgba(37,211,102,0.14);
    outline:none;
  }
  .field.invalid input{border-color:#E08A8A; box-shadow:0 0 0 3px rgba(224,138,138,0.12);}
  .field small.err{color:#E08A8A; font-size:0.75rem; min-height:1em; display:none;}
  .field.invalid small.err{display:block;}

  .dash-actions{display:flex; gap:14px; flex-wrap:wrap; align-items:center;}
  .btn-wa{
    font-family:var(--body); font-weight:800; font-size:0.95rem;
    background:linear-gradient(120deg, #128C4B, #25D366);
    color:#fff;
    border:none;
    padding:16px 32px;
    border-radius:999px;
    cursor:pointer;
    box-shadow:0 12px 30px rgba(37,211,102,0.35);
    transition:transform .18s ease, box-shadow .18s ease;
    display:inline-flex; align-items:center; gap:10px;
  }
  .btn-wa:hover{transform:translateY(-2px); box-shadow:0 16px 38px rgba(37,211,102,0.5);}
  .btn-copy{
    font-family:var(--body); font-weight:700; font-size:0.88rem;
    background:transparent;
    color:var(--gold-soft);
    border:1px solid var(--gold);
    padding:15px 26px;
    border-radius:999px;
    cursor:pointer;
    transition:background .18s ease, transform .18s ease;
  }
  .btn-copy:hover{background:rgba(217,178,76,0.12); transform:translateY(-2px);}

  .dash-note{
    margin-top:22px;
    font-size:0.8rem;
    color:var(--ink-dim);
    display:flex; align-items:center; gap:10px;
  }
  .dash-note b{color:#25D366;}
  .dash-success{
    display:none;
    margin-top:20px;
    border:1px solid #25D366;
    border-radius:12px;
    padding:16px 18px;
    color:#B9F5D2;
    font-size:0.88rem;
    background:rgba(37,211,102,0.08);
    line-height:1.55;
  }
  .dash-success.show{display:block;}
  .ref-code{
    display:inline-block;
    margin-top:10px;
    font-family:var(--display);
    font-size:0.85rem;
    letter-spacing:0.08em;
    color:var(--gold-soft);
    border:1px dashed var(--gold);
    border-radius:8px;
    padding:8px 14px;
  }

  /* ============ FOOTER ============ */
  footer{
    position:relative; z-index:1;
    margin:24px 0 44px;
    border:1px solid var(--line);
    border-radius:20px;
    padding:34px 40px;
    background:linear-gradient(160deg, rgba(155,79,224,0.08), rgba(217,178,76,0.04));
    display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:18px;
  }
  .contact-list{display:flex; gap:26px; flex-wrap:wrap; font-size:0.86rem; color:var(--ink-dim);}
  .contact-list a:hover{color:var(--gold-soft);}
  .footer-script{
    font-family:var(--script);
    font-size:1.7rem;
    color:var(--gold-soft);
    text-align:right;
    line-height:1.15;
  }

  /* ============ FLOATING WHATSAPP ============ */
  .wa-float{
    position:fixed; bottom:24px; right:24px; z-index:60;
    width:58px; height:58px;
    border-radius:50%;
    background:linear-gradient(135deg, #128C4B, #25D366);
    display:flex; align-items:center; justify-content:center;
    font-size:1.6rem;
    box-shadow:0 12px 30px rgba(37,211,102,0.45);
    transition:transform .18s ease, box-shadow .18s ease;
    animation:waPulse 2.4s ease-in-out infinite;
  }
  .wa-float:hover{transform:scale(1.1);}
  @keyframes waPulse{
    0%,100%{box-shadow:0 12px 30px rgba(37,211,102,0.45);}
    50%{box-shadow:0 12px 40px rgba(37,211,102,0.7);}
  }

